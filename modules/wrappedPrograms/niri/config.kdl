spawn-at-startup "noctalia-shell"

switch-events {
    lid-close {
        spawn "noctalia-shell" "ipc" "call" "lockScreen" "lock"
    }
}

input {
    keyboard {
        xkb {
            layout "au"
        }
    }
    touchpad {
        click-method "clickfinger"
        natural-scroll
        scroll-factor 0.5
        scroll-method "two-finger"
        tap
        tap-button-map "left-right-middle"
    }
}

cursor {
    xcursor-size 40
    xcursor-theme "Posy_Cursor_Black"
    hide-after-inactive-ms 2000
}

// Domino
output "eDP-1" {
    focus-at-startup
    mode "2880x1920@120.000"
    position x=1000 y=1440
    scale 2
}
output "DP-3" {
    mode "1920x1080@60.000"
    position x=760 y=360
    scale 1
}
output "DP-5" {
    mode "3440x1440@120.000"
    position x=0 y=0
    scale 1
}
output "DP-7" {
    mode "3440x1440@120.000"
    position x=0 y=0
    scale 1
}

// Dominator
output "ASUSTek COMPUTER INC VG27A N5LMQS090248" {
    focus-at-startup
    mode "2560x1440@143.972"
    position x=2560 y=0
    scale 1
}
output "LG Electronics LG ULTRAWIDE 0x000221D3" {
    mode "2560x1080@60.000"
    position x=0 y=360
    scale 1
}

// Use `nix-shell -p wev --command wev` to find key names
binds {
    // General
    Mod+Ctrl+Alt+Q { quit; }
    Mod+Ctrl+Alt+Slash { show-hotkey-overlay; }

    Mod+Q { close-window; }
    Mod+C { center-column; }
    Mod+D { maximize-column; }
    Mod+F { fullscreen-window; }
    Mod+G { toggle-windowed-fullscreen; }
    Mod+O { toggle-overview; }
    Mod+S { screenshot show-pointer=false; }

    // Columns & Windows
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+WheelScrollUp { focus-column-left; }
    Mod+WheelScrollDown { focus-column-right; }
    Mod+Alt+WheelScrollUp { focus-window-up; }
    Mod+Alt+WheelScrollDown { focus-window-down; }

    Mod+V { switch-focus-between-floating-and-tiling; }
    Mod+Shift+V { toggle-window-floating; }

    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+WheelScrollUp { move-column-left; }
    Mod+Shift+WheelScrollDown { move-column-right; }
    Mod+Shift+Alt+WheelScrollUp { move-window-up; }
    Mod+Shift+Alt+WheelScrollDown { move-window-down; }

    Mod+Shift+Comma { consume-or-expel-window-left; }
    Mod+Shift+Period { consume-or-expel-window-right; }

    Mod+Ctrl+Left { set-column-width "-5%"; }
    Mod+Ctrl+Right { set-column-width "+5%"; }
    Mod+Ctrl+Up { set-window-height "-5%"; }
    Mod+Ctrl+Down { set-window-height "+5%"; }
    Mod+Ctrl+WheelScrollUp { set-column-width "-5%"; }
    Mod+Ctrl+WheelScrollDown { set-column-width "+5%"; }
    Mod+Ctrl+Alt+WheelScrollUp { set-window-height "-5%"; }
    Mod+Ctrl+Alt+WheelScrollDown { set-window-height "+5%"; }

    // Monitors
    Mod+Alt+Left { focus-monitor-left; }
    Mod+Alt+Right { focus-monitor-right; }
    Mod+Alt+Up { focus-monitor-up; }
    Mod+Alt+Down { focus-monitor-down; }
    Mod+Alt+Apostrophe { focus-monitor-previous; }
    Mod+Alt+Slash { focus-monitor-next; }

    Mod+Shift+Alt+Left { move-column-to-monitor-left; }
    Mod+Shift+Alt+Right { move-column-to-monitor-right; }
    Mod+Shift+Alt+Up { move-column-to-monitor-up; }
    Mod+Shift+Alt+Down { move-column-to-monitor-down; }
    Mod+Shift+Alt+Apostrophe { move-column-to-monitor-previous; }
    Mod+Shift+Alt+Slash { move-column-to-monitor-next; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Apostrophe { focus-workspace-up; }
    Mod+Slash { focus-workspace-down; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }
    Mod+Shift+Apostrophe { move-window-to-workspace-up; }
    Mod+Shift+Slash { move-window-to-workspace-down; }

    // Apps
    Mod+Alt+Return { spawn-sh "kitty"; }
    Mod+Alt+B { spawn-sh "firefox"; }
    Mod+Alt+C { spawn-sh "code"; }
    Mod+Alt+D { spawn-sh "discord"; }
    Mod+Alt+F { spawn-sh "kitty --hold fastfetch"; }
    Mod+Alt+G { spawn-sh "gimp"; }
    Mod+Alt+H { spawn-sh "bash -ci 'open https://home.google.com/u/0/home/1'"; }
    Mod+Alt+I { spawn-sh "inkscape"; }
    Mod+Alt+L { spawn-sh "spotify"; }
    Mod+Alt+M { spawn-sh "gnome-calculator"; }
    Mod+Alt+N { spawn-sh "nautilus"; }
    Mod+Alt+O { spawn-sh "obsidian"; }
    Mod+Alt+P { spawn-sh "scrcpy"; }
    Mod+Alt+Q { spawn-sh "~/MyNixOS/scripts/flip_coin.sh"; }
    Mod+Alt+R { spawn-sh "remmina"; }
    Mod+Alt+S { spawn-sh "steam"; }
    Mod+Alt+U { spawn-sh "baobab"; }
    Mod+Alt+V { spawn-sh "kitty --hold protonvpn connect"; }
    Mod+Alt+W { spawn-sh "quickemu --vm ~/Machines/windows-11.conf"; }
    Mod+Alt+X { spawn-sh "kitty --hold protonvpn disconnect"; }
    Mod+Alt+Z { spawn-sh "super-productivity"; }
    Mod+Alt+3 { spawn-sh "bash -ci deltarune"; }

    // Noctalia
    Ctrl+Alt+Delete { spawn-sh "noctalia-shell ipc call sessionMenu toggle"; }
    Ctrl+Alt+Slash { spawn-sh "noctalia-shell ipc call launcher toggle"; }
    Ctrl+Alt+L { spawn-sh "noctalia-shell ipc call lockScreen lock"; }

    XF86AudioPlay { spawn-sh "noctalia-shell ipc call media playPause"; }
    XF86AudioStop { spawn-sh "noctalia-shell ipc call media stop"; }
    XF86AudioPrev { spawn-sh "noctalia-shell ipc call media previous"; }
    XF86AudioNext { spawn-sh "noctalia-shell ipc call media next"; }
    XF86AudioMute { spawn-sh "noctalia-shell ipc call volume muteOutput"; }
    XF86AudioLowerVolume { spawn-sh "noctalia-shell ipc call volume decrease"; }
    XF86AudioRaiseVolume { spawn-sh "noctalia-shell ipc call volume increase"; }
    XF86MonBrightnessDown { spawn-sh "noctalia-shell ipc call brightness decrease"; }
    XF86MonBrightnessUp { spawn-sh "noctalia-shell ipc call brightness increase"; }
    XF86AudioMedia { spawn-sh "noctalia-shell ipc call media toggle"; }
    XF86Explorer { spawn-sh "noctalia-shell ipc call systemMonitor toggle"; }
    XF86Search { spawn-sh "noctalia-shell ipc call launcher toggle"; }
    XF86Calculator { spawn-sh "gnome-calculator"; }
    XF86Tools { spawn-sh "noctalia-shell ipc call controlCenter toggle"; }
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

layout {
    gaps 8
    focus-ring {
        width 8
        active-gradient angle=45 from="#37f499c0" to="#04d1f9c0"
        inactive-gradient angle=45 from="#808080c0" to="#404040c0"
    }
}

// Noctalia Setup (https://docs.noctalia.dev/getting-started/compositor-settings/niri/)
debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}

layer-rule {
  // Set the overview wallpaper on the backdrop.
  match namespace="^noctalia-overview*"
  place-within-backdrop true
}

// First 60 seconds
window-rule {
  match at-startup=true
  open-maximized true
}

// Fullscreen
window-rule {
  match app-id="qemu"
  open-fullscreen true
}

// Phone Dimensions
window-rule {
  match app-id=".scrcpy-wrapped"
  default-column-width { fixed 630; }
  default-window-height { fixed 1424; }
}

// Floating Tall Rectangle
window-rule {
  match app-id="org.gnome.Calculator"
  match title="Friends List"
  open-floating true
  default-column-width { fixed 360; }
  default-window-height { fixed 720; }
}

// DELTARUNE
window-rule {
  match app-id="steam_app_1671210"

  open-floating true
  open-focused true

  shadow {
    on
  }
}
window-rule {
  match title="^DELTARUNE$"

  focus-ring {
    active-color "#00c000"
    inactive-color "#666666"
  }
}
window-rule {
  match title="^DELTARUNE Chapter 1$"

  focus-ring {
    active-gradient angle=270 from="#e02040" to="#6c06c1"
    inactive-color "#666666"
  }
}
window-rule {
  match title="^DELTARUNE Chapter 2$"

  focus-ring {
    active-gradient angle=300 from="#31d989" to="#00a2e8"
    inactive-color "#666666"
  }
}
window-rule {
  match title="^DELTARUNE Chapter 3$"

  focus-ring {
    active-gradient angle=330 from="#ff2d39" to="#db7727"
    inactive-color "#666666"
  }
}
window-rule {
  match title="^DELTARUNE Chapter 4$"

  focus-ring {
    active-gradient angle=0 from="#122cf1" to="#77ffff"
    inactive-color "#666666"
  }
}
window-rule {
  match title="^DELTARUNE Chapter 5$"

  focus-ring {
    active-gradient angle=30 from="#82af86" to="#5060eb"
    inactive-color "#666666"
  }
}
window-rule {
  match title="^DELTARUNE Chapter 6$"

  focus-ring {
    active-gradient angle=60 from="#ff0000" to="#660000"
    inactive-color "#666666"
  }
}
window-rule {
  match title="^DELTARUNE Chapter 7$"

  focus-ring {
    active-gradient angle=90 from="#ff0000" to="#660000"
    inactive-color "#666666"
  }
}
